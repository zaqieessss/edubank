<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Paksa HTTPS (Otomatis beralih ke https:// saat diakses via http://)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 2. Lindungi berkas sensitif dari akses publik langsung
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml) - [F,L]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage/logs|tests|vendor) - [F,L]

    # 3. Arahkan semua lalu lintas web ke folder public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
